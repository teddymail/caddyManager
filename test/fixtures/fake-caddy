#!/bin/sh
# 测试用假 caddy：fmt/validate/version 成功；reload/start 受 FAKE_FAIL 控制
case "$1" in
  version) echo "v2.7.6 (fake)"; exit 0 ;;
  fmt) exit 0 ;;
  validate) echo "Valid configuration"; exit 0 ;;
  reload) [ "$FAKE_FAIL" = "1" ] && { echo "reload failed" >&2; exit 1; }; echo "Reloading..."; exit 0 ;;
  start) [ "$FAKE_FAIL" = "1" ] && { echo "start failed" >&2; exit 1; }; echo "Starting..."; exit 0 ;;
  *) echo "unknown cmd: $1" >&2; exit 1 ;;
esac
